# Python bytecode
__pycache__/
*.py[cod]

# Packaging / build artifacts
build/
dist/
wheels/
*.egg-info/

# Virtual environments
.venv/
venv/

# Tool caches
# Ruff and pytest each write their own .gitignore inside these; listed here so
# they stay ignored even when that file is absent (fresh clone, cache deleted).
.ruff_cache/
.pytest_cache/
.mypy_cache/
.ty_cache/

# Coverage
.coverage
.coverage.*
coverage.xml
htmlcov/

# Notebooks
# The percent-format scripts in notebooks/ are the source of truth; any .ipynb
# is generated from them by jupytext and should not be committed.
notebooks/*.ipynb
.ipynb_checkpoints/

# Secrets — settings come from .env via pydantic-settings, never from git
.env
.env.*
!.env.example

# Local scrape and survey output
data/

# Editors
.idea/
.vscode/

# macOS
.DS_Store

# Claude Code worktrees — each is its own checkout of this repo; never track them
.claude/worktrees/
