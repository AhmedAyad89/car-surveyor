{
  "permissions": {
    "deny": [
      "Read(~/refdata/**)",
      "WebFetch(domain:visor.vin)",
      "WebFetch(domain:*.visor.vin)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": ["~/refdata", "~/refdata/**"]
    },
    "network": {
      "deniedDomains": ["visor.vin", "*.visor.vin"]
    }
  }
}
